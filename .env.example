# ---------- Aplicación ----------
APP_ENV=local
APP_DEBUG=true
APP_PORT=4107

# ---------- PostgreSQL ----------
# (En Docker, DB_HOST/DB_PORT/REDIS_HOST se sobrescriben automáticamente)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fitbase
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer
DB_PERSISTENT=true
DB_TIMEOUT=5
DB_STATEMENT_TIMEOUT=5000
DB_APP_NAME=fitbase_api
# Puertos expuestos en tu máquina (Docker)
DB_EXTERNAL_PORT=5433
REDIS_EXTERNAL_PORT=6379

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- URLs / CORS ----------
HOST_URL_DEV=http://localhost:3000
HOST_URL_DEV_V2=http://localhost:3000
HOST_URL_PROD=http://localhost:3000
HOST_URL_PROD_WWW=http://localhost:3000
HOST_API_DEV=http://localhost:4107
HOST_API_PROD=http://localhost:3000
HOST_API_PROD_WWW=http://localhost:3000
PUBLIC_API_BASE=http://localhost:4107
HOST_PYTHON_API_URL=http://0.0.0.0:8001

# ---------- Seguridad ----------
SECRET_KEY_JWT=cambia_esta_clave_de_32_caracteres

# ---------- SMTP ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
API_KEY_SMTP=
API_KEY_SMTP_KEY=
ADMIN_EMAIL=tu_correo@gmail.com

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
